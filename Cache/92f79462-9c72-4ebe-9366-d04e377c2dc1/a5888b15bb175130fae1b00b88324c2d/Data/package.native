  Description: World Object Controller allows you to add a 3D object to the world that the user can walk towards and around. This tool gives you access to manipulation control which allows the user to move, scale and rotate the object.
  SvgIcon: ""
  SetupScript:
    code: "// This script is used to automatically instantiate world object controller prefabs in the scene when the asset is added to the project.\n\nreturn function (asset, scene, target, setupScriptInterface) {\n    try {\n        let assetManager = setupScriptInterface.getAssetManager();\n        let scene = setupScriptInterface.getScene();\n        let utils = setupScriptInterface.getUtils();\n        // get asset path\n        let prefabFile = asset.fileMeta.sourcePath.parent.appended('World Object Controller__ADD_TO_SCENE.prefab');\n        // get prefab asset reference\n        const prefab = assetManager.getFileMeta(prefabFile).primaryAsset;\n        // instantiate prefab at root\n        let sceneObject = scene.instantiatePrefab(prefab, null);\n\n        // now let's check if there is a device tracking component\n         utils.getOrAddDeviceTracking(scene);\n    } catch (e) {\n        console.log(e)\n    }\n}"
